<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Chirograph.Application\Chirograph.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="DnsClient" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Liberation Sans (SIL OFL 1.1, see Pdf/Fonts/OFL.txt) is embedded so stamping renders identically on every OS. -->
    <EmbeddedResource Include="Pdf\Fonts\*.ttf" LogicalName="Chirograph.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chirograph.UnitTests" />
  </ItemGroup>
</Project>
