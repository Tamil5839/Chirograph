@page "/auth/denied"
@model DeniedModel
@{
    ViewData["Title"] = "Not allowed";
}

<div class="col-lg-7 py-4">
    <h1 class="h3">You don't have access to that page</h1>
    <p class="text-muted">It may need an admin of your organization, or a different kind of sign-in.</p>
    <a asp-page="/Index">Go to the home page</a>
</div>
