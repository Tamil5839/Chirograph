@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="col-lg-7 py-4">
    <h1 class="h3">@Model.Heading</h1>
    <p class="text-muted">@Model.Explanation</p>
    <a asp-page="/Index">Go to the home page</a>
    @if (Model.RequestId is not null)
    {
        <p class="small text-muted mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>
